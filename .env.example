# AlphaScreen — Environment Variables (all OPTIONAL)
#
# AlphaScreen is "bring your own key": visitors paste their Gemini API key in the
# UI and it is used per-request, never stored server-side. You do NOT need to set
# anything here to run the app.
#
# Set GEMINI_API_KEY only if you want a SERVER-SIDE FALLBACK key — used when a
# request arrives without its own key (e.g. local dev convenience, or a future
# hosted/credits mode). Visitor-supplied keys always take precedence.
#
# Get a free key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY="your_gemini_api_key_here"

# PORT is provided automatically by most hosts. Override locally if needed.
# PORT=3000
