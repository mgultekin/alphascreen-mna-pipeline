{
  "name": "alphascreen-mna-pipeline",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered M&A Deal Sourcing Pipeline — Automated screening of listed companies combining quantitative financial data (Yahoo Finance + SEC EDGAR) with qualitative NLP analysis (Google Gemini).",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.mjs server.mjs.map",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "yahoo-finance2": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
