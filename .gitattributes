# Normalize line endings to LF in the repository so Windows (local) and
# Linux/cloud agents (e.g. Google Antigravity) don't produce phantom diffs.
* text=auto eol=lf

# Shell scripts must stay LF
*.sh text eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
